# Copy to .env.local for local development. Never commit real secrets.

# Neon PostgreSQL (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/realtyos?sslmode=require

# Public app origin (used for absolute links, auth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (to be configured) ---
# AUTH_SECRET=generate-a-long-random-string
# AUTH_URL=http://localhost:3000

